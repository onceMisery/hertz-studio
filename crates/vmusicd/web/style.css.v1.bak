/* SPDX-License-Identifier: MIT
   Copyright (c) 2026 mmusic-studio contributors

   Visual language: glassmorphism over a blurred, scaled-up copy of the current
   cover — the same direction as VCP's music module, so the two feel related
   without sharing code. Only presentation lives here; the DOM contract used by
   app.js (ids and class names) is unchanged. */

:root {
  --bg: #0d0f12;
  --panel: rgba(24, 27, 32, 0.66);
  --panel-solid: #171a1f;
  --panel-2: rgba(255, 255, 255, 0.05);
  --line: rgba(255, 255, 255, 0.09);
  --line-strong: rgba(255, 255, 255, 0.16);
  --text: #eef1f5;
  --muted: #97a0af;
  --accent: #1dbf8f;
  --accent-2: #7f77dd;
  --hover: rgba(255, 255, 255, 0.07);
  --radius: 12px;
  --radius-lg: 18px;
  --shadow: 0 12px 32px rgba(0, 0, 0, 0.42);
  /* VCP's easing: quick departure, long settle. */
  --ease: cubic-bezier(0.22, 1, 0.36, 1);
  --bar-h: 76px;
}

* { box-sizing: border-box; }

html, body { height: 100%; margin: 0; }

body {
  background: var(--bg);
  color: var(--text);
  font: 14px/1.55 system-ui, -apple-system, "Segoe UI", "Microsoft YaHei", sans-serif;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* Soft light pools so the glass has something to refract even with no art. */
body::before {
  content: "";
  position: fixed;
  inset: -20%;
  z-index: -2;
  background:
    radial-gradient(38% 30% at 12% 8%, rgba(29, 191, 143, 0.16), transparent 70%),
    radial-gradient(42% 34% at 88% 92%, rgba(127, 119, 221, 0.16), transparent 70%);
}

/* Ambient cover backdrop; app.js fills the inner layer with the current art. */
#ambient {
  position: fixed;
  inset: -40px;
  z-index: -1;
  overflow: hidden;
  pointer-events: none;
}
#ambient .ambient-img {
  position: absolute;
  inset: 0;
  background: center / cover no-repeat;
  filter: blur(64px) saturate(140%) brightness(0.5);
  transform: scale(1.15);
  opacity: 0;
  transition: opacity 0.8s var(--ease), background-image 0.5s var(--ease);
}
#ambient.has-art .ambient-img { opacity: 1; }

.hint { color: var(--muted); font-size: 12px; }

.app {
  flex: 1;
  display: grid;
  grid-template-columns: 320px minmax(0, 1fr);
  gap: 16px;
  padding: 16px 16px 0;
  min-height: 0;
}

/* Every surface is the same glass recipe: translucent, hairline, blurred. */
.sidebar, .main, .bar {
  background: var(--panel);
  backdrop-filter: blur(22px) saturate(150%);
  -webkit-backdrop-filter: blur(22px) saturate(150%);
  border: 1px solid var(--line);
  box-shadow: var(--shadow);
}

/* ---------- sidebar ---------- */

.sidebar {
  border-radius: var(--radius-lg);
  padding: 18px;
  display: flex;
  flex-direction: column;
  gap: 16px;
  overflow-y: auto;
  min-height: 0;
}

.brand {
  font-size: 17px;
  font-weight: 650;
  letter-spacing: 0.2px;
  display: flex;
  align-items: center;
  gap: 9px;
}
.brand::before {
  content: "";
  width: 9px; height: 9px;
  border-radius: 50%;
  background: var(--accent);
  box-shadow: 0 0 12px var(--accent);
}
.brand span { color: var(--muted); font-weight: 400; }

input[type="search"], input[type="text"] {
  width: 100%;
  padding: 9px 12px;
  border-radius: var(--radius);
  border: 1px solid var(--line);
  background: var(--panel-2);
  color: var(--text);
  outline: none;
  transition: border-color 0.2s var(--ease), background 0.2s var(--ease);
}
input::placeholder { color: var(--muted); }
input:focus {
  border-color: var(--accent);
  background: rgba(29, 191, 143, 0.07);
}

.panel {
  background: var(--panel-2);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 12px;
}
.panel-title {
  font-size: 11px;
  color: var(--muted);
  margin-bottom: 9px;
  text-transform: uppercase;
  letter-spacing: 0.9px;
  font-weight: 600;
}

.scan-row, .new-playlist { display: flex; gap: 8px; }
.scan-row input { flex: 1; min-width: 0; }
#scan-status { margin-top: 8px; min-height: 16px; }

.btn {
  padding: 8px 14px;
  border-radius: 999px;
  border: 1px solid var(--line);
  background: var(--panel-2);
  color: var(--text);
  cursor: pointer;
  white-space: nowrap;
  font-size: 13px;
  transition: background 0.2s var(--ease), border-color 0.2s var(--ease),
              transform 0.15s var(--ease), color 0.2s var(--ease);
}
.btn:hover:not(:disabled) {
  background: var(--hover);
  border-color: var(--line-strong);
}
.btn:active:not(:disabled) { transform: scale(0.96); }
.btn:disabled { opacity: 0.45; cursor: default; }
.btn.primary {
  background: var(--accent);
  border-color: transparent;
  color: #04140e;
  font-weight: 600;
}
.btn.primary:hover:not(:disabled) { filter: brightness(1.08); }

.playlists { display: flex; flex-direction: column; gap: 4px; }
.playlist {
  text-align: left;
  background: transparent;
  border: none;
  color: var(--text);
  padding: 9px 11px;
  border-radius: var(--radius);
  cursor: pointer;
  font-size: 13px;
  transition: background 0.2s var(--ease), color 0.2s var(--ease);
}
.playlist:hover { background: var(--hover); }

/* ---------- track list ---------- */

.track-list {
  display: flex;
  flex-direction: column;
  gap: 2px;
  overflow-y: auto;
  min-height: 0;
  flex: 1;
  margin: 0 -4px;
  padding: 0 4px;
}
.track {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 9px 11px;
  border-radius: var(--radius);
  cursor: pointer;
  position: relative;
  transition: background 0.2s var(--ease), transform 0.2s var(--ease);
}
.track:hover { background: var(--hover); }
.track:active { transform: scale(0.99); }
.track.active { background: rgba(29, 191, 143, 0.14); }
/* A left marker reads as "now playing" even in a long, scrolling list. */
.track.active::before {
  content: "";
  position: absolute;
  left: 0; top: 50%;
  width: 3px; height: 62%;
  transform: translateY(-50%);
  border-radius: 0 3px 3px 0;
  background: var(--accent);
}
.track.active .track-title { color: var(--accent); font-weight: 600; }
.track-main { flex: 1; min-width: 0; }
.track-title {
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  font-size: 13.5px;
}
.track-sub {
  color: var(--muted); font-size: 12px;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.track-dur {
  color: var(--muted); font-size: 12px;
  font-variant-numeric: tabular-nums;
  flex: none;
}

.spacer { flex: 1; }
.conn {
  font-size: 12px;
  color: var(--muted);
  display: flex;
  align-items: center;
  gap: 7px;
}
.conn::before {
  content: "";
  width: 7px; height: 7px; border-radius: 50%;
  background: var(--muted);
}
.conn.ok { color: var(--accent); }
.conn.ok::before { background: var(--accent); box-shadow: 0 0 8px var(--accent); }
.conn.bad { color: #ff8080; }
.conn.bad::before { background: #ff8080; }

/* ---------- main ---------- */

.main {
  border-radius: var(--radius-lg);
  display: grid;
  grid-template-rows: auto minmax(0, 1fr);
  min-height: 0;
  overflow: hidden;
  position: relative;
}

.mobile-top { display: none; }

.now {
  display: flex;
  gap: 22px;
  padding: 22px;
  align-items: center;
  border-bottom: 1px solid var(--line);
}

.cover {
  width: 148px;
  height: 148px;
  border-radius: 16px;
  background: var(--panel-2) center/cover no-repeat;
  border: 1px solid var(--line);
  flex: none;
  box-shadow: 0 10px 28px rgba(0, 0, 0, 0.5);
  transition: transform 0.35s var(--ease), background-image 0.5s var(--ease);
}
.cover:hover { transform: scale(1.03); }

.now-meta { flex: 1; min-width: 0; }
.now-title {
  font-size: 24px;
  font-weight: 650;
  letter-spacing: -0.2px;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.now-artist {
  color: var(--muted);
  font-size: 13.5px;
  margin-top: 5px;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.now-tech {
  color: var(--muted);
  font-size: 11.5px;
  margin-top: 7px;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 3px 9px;
  border-radius: 999px;
  border: 1px solid var(--line);
  background: var(--panel-2);
  font-variant-numeric: tabular-nums;
}
.spectrum { width: 100%; max-width: 640px; height: 84px; display: block; margin-top: 14px; }

.lyrics {
  overflow-y: auto;
  padding: 26px 26px 48px;
  display: flex;
  flex-direction: column;
  gap: 14px;
  text-align: center;
  scroll-behavior: smooth;
}
.lyric {
  color: var(--muted);
  font-size: 15px;
  line-height: 1.5;
  transition: color 0.35s var(--ease), transform 0.35s var(--ease), opacity 0.35s var(--ease);
  opacity: 0.75;
}
.lyric.active {
  color: var(--text);
  font-weight: 650;
  opacity: 1;
  transform: scale(1.06);
}

/* ---------- player bar ---------- */

.bar {
  margin: 16px;
  border-radius: var(--radius-lg);
  display: grid;
  /* 5 columns for 5 children — otherwise the mode pill wraps to a second row. */
  grid-template-columns: minmax(140px, 1fr) auto minmax(150px, 1.2fr) 116px auto;
  align-items: center;
  gap: 18px;
  padding: 12px 20px;
  min-height: var(--bar-h);
}

.bar-track { min-width: 0; }
.bar-title {
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  font-size: 13.5px; font-weight: 600;
}
.bar-time {
  color: var(--muted); font-size: 12px;
  font-variant-numeric: tabular-nums;
  margin-top: 2px;
}

.bar-controls { display: flex; gap: 10px; align-items: center; justify-content: center; }

/* Icon buttons share one geometry so the row reads as a single control group. */
.ctrl {
  width: 40px; height: 40px;
  display: inline-flex; align-items: center; justify-content: center;
  border-radius: 50%;
  border: 1px solid transparent;
  background: transparent;
  color: var(--muted);
  cursor: pointer;
  padding: 0;
  transition: color 0.25s var(--ease), background 0.25s var(--ease), transform 0.15s var(--ease);
}
.ctrl:hover { color: var(--text); background: var(--hover); }
.ctrl:active { transform: scale(0.9); }
.ctrl svg { width: 20px; height: 20px; fill: currentColor; display: block; }

.ctrl-primary {
  width: 52px; height: 52px;
  background: var(--accent);
  color: #04140e;
  box-shadow: 0 6px 18px rgba(29, 191, 143, 0.32);
}
.ctrl-primary:hover { background: var(--accent); filter: brightness(1.08); color: #04140e; }
.ctrl-primary svg { width: 24px; height: 24px; }
.ctrl-primary .ic-pause { display: none; }
.ctrl-primary.is-playing .ic-play { display: none; }
.ctrl-primary.is-playing .ic-pause { display: block; }

/* Mode is a state label, not an icon action — a pill keeps it secondary. */
.btn-pill {
  padding: 7px 14px;
  border-radius: 999px;
  border: 1px solid var(--line);
  background: transparent;
  color: var(--muted);
  cursor: pointer;
  font-size: 12.5px;
  white-space: nowrap;
  transition: color 0.25s var(--ease), background 0.25s var(--ease), transform 0.15s var(--ease);
}
.btn-pill:hover { color: var(--text); background: var(--hover); }
.btn-pill:active { transform: scale(0.95); }

/* Range inputs: flat track that thickens on hover, round accent thumb. */
input[type="range"] {
  -webkit-appearance: none;
  appearance: none;
  width: 100%;
  background: transparent;
  cursor: pointer;
  height: 18px;
}
input[type="range"]::-webkit-slider-runnable-track {
  height: 5px;
  border-radius: 99px;
  background: var(--hover);
  transition: height 0.2s var(--ease);
}
input[type="range"]:hover::-webkit-slider-runnable-track { height: 8px; }
input[type="range"]::-webkit-slider-thumb {
  -webkit-appearance: none;
  width: 13px; height: 13px;
  margin-top: -4px;
  border-radius: 50%;
  background: var(--accent);
  border: none;
  box-shadow: 0 0 0 0 rgba(29, 191, 143, 0.25);
  transition: box-shadow 0.2s var(--ease), margin-top 0.2s var(--ease);
}
input[type="range"]:hover::-webkit-slider-thumb {
  margin-top: -5.5px;
  box-shadow: 0 0 0 6px rgba(29, 191, 143, 0.18);
}
input[type="range"]::-moz-range-track {
  height: 5px; border-radius: 99px; background: var(--hover);
}
input[type="range"]::-moz-range-thumb {
  width: 13px; height: 13px; border: none; border-radius: 50%; background: var(--accent);
}

.bar-progress { display: flex; align-items: center; }
.bar-volume { display: flex; align-items: center; gap: 10px; }
.bar-volume .hint { flex: none; }
.bar-volume input[type="range"] { max-width: 92px; }
.bar-mode-cell { justify-self: end; }

/* ---------- scrollbars ---------- */

.sidebar::-webkit-scrollbar, .track-list::-webkit-scrollbar, .lyrics::-webkit-scrollbar { width: 9px; }
.sidebar::-webkit-scrollbar-thumb,
.track-list::-webkit-scrollbar-thumb,
.lyrics::-webkit-scrollbar-thumb {
  background: rgba(255, 255, 255, 0.12);
  border-radius: 99px;
  border: 2px solid transparent;
  background-clip: content-box;
}
.sidebar::-webkit-scrollbar-thumb:hover,
.track-list::-webkit-scrollbar-thumb:hover,
.lyrics::-webkit-scrollbar-thumb:hover { background: rgba(255, 255, 255, 0.2); background-clip: content-box; }

/* ---------- toast ---------- */

.toast {
  position: fixed;
  left: 50%;
  bottom: 108px;
  transform: translateX(-50%) translateY(6px);
  max-width: min(88vw, 520px);
  padding: 11px 18px;
  border-radius: 999px;
  border: 1px solid var(--line-strong);
  background: rgba(20, 23, 27, 0.9);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  color: var(--text);
  font-size: 13px;
  line-height: 1.5;
  box-shadow: var(--shadow);
  z-index: 60;
  opacity: 0;
  transition: opacity 0.25s var(--ease), transform 0.25s var(--ease);
}
.toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
.toast[hidden] { display: none; }
.toast.error { border-color: rgba(255, 90, 90, 0.5); color: #ffb3b3; }

/* ---------- responsive ---------- */

#nav-scrim {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(2px);
  -webkit-backdrop-filter: blur(2px);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s var(--ease);
  z-index: 40;
}
body.nav-open #nav-scrim { opacity: 1; pointer-events: auto; }

@media (max-width: 1100px) {
  .app { grid-template-columns: 280px minmax(0, 1fr); }
  .bar { grid-template-columns: minmax(110px, 1fr) auto minmax(120px, 1fr) 96px auto; gap: 14px; }
}

@media (max-width: 860px) {
  .app { grid-template-columns: minmax(0, 1fr); padding: 12px 12px 0; }

  /* Keep the library reachable: it becomes a drawer instead of vanishing. */
  .sidebar {
    position: fixed;
    top: 12px; bottom: 12px; left: 12px;
    width: min(320px, 84vw);
    z-index: 50;
    transform: translateX(calc(-100% - 16px));
    transition: transform 0.34s var(--ease);
    border-radius: var(--radius-lg);
  }
  body.nav-open .sidebar { transform: translateX(0); }

  .mobile-top { display: flex; align-items: center; gap: 12px; padding: 12px 16px; border-bottom: 1px solid var(--line); }
  .mobile-top .title { font-size: 15px; font-weight: 600; }

  .now { padding: 16px; gap: 16px; }
  .cover { width: 96px; height: 96px; border-radius: 14px; }
  .now-title { font-size: 19px; }
  .spectrum { height: 60px; margin-top: 10px; }
  .lyrics { padding: 18px 16px 40px; gap: 11px; }
  .lyric { font-size: 14px; }

  /* Two rows: transport on top, progress underneath — nothing gets squashed. */
  .bar {
    margin: 12px;
    grid-template-columns: auto 1fr auto;
    grid-template-areas:
      "track controls mode"
      "progress progress progress";
    gap: 10px 12px;
    padding: 12px 14px;
  }
  .bar-track { grid-area: track; }
  .bar-controls { grid-area: controls; }
  .bar-volume { display: none; }
  .bar-progress { grid-area: progress; }
  .bar-mode-cell { grid-area: mode; justify-self: end; }

  #menu-btn { display: inline-flex; }
}

@media (max-width: 480px) {
  .bar-controls { gap: 6px; }
  .ctrl { width: 36px; height: 36px; }
  .ctrl-primary { width: 46px; height: 46px; }
  .now { gap: 12px; }
  .cover { width: 80px; height: 80px; }
}

@media (prefers-reduced-motion: reduce) {
  * { transition-duration: 0.01ms !important; animation-duration: 0.01ms !important; }
}
